import { db, auth, events } from "hatchable";

export const access = "public";
export const methods = ["GET", "POST"];

export default async function (req, res) {
    try {
        const user = await auth.getUser(req);

        if (!user) {
            return res.status(401).json({
                error: "Please sign in first."
            });
        }

        const userId = user.id;

        // GET: Load StreetSpot data
        if (req.method === "GET") {
            const profile = await db.query(
                `SELECT role, display_name
                 FROM streetspot_profiles
                 WHERE user_id = $1`,
                [userId]
            );

            const vendors = await db.query(
                `SELECT id, name, category, lat, lng,
                        is_live, expires_at, avatar
                 FROM streetspot_vendors
                 WHERE is_live = true
                   AND expires_at > now()
                 ORDER BY created_at DESC`
            );

            const items = await db.query(
                `SELECT id, vendor_id, name, price
                 FROM streetspot_items
                 ORDER BY created_at`
            );

            const ownVendor = await db.query(
                `SELECT id, name, category, lat, lng,
                        is_live, expires_at, avatar
                 FROM streetspot_vendors
                 WHERE user_id = $1`,
                [userId]
            );

            return res.json({
                profile: profile.rows[0] || null,
                vendors: vendors.rows,
                items: items.rows,
                ownVendor: ownVendor.rows[0] || null
            });
        }

        const body = req.body || {};

        // Choose customer or vendor role
        if (body.action === "role") {
            const role =
                body.role === "vendor" ? "vendor" : "consumer";

            await db.query(
                `INSERT INTO streetspot_profiles
                 (user_id, role, display_name)
                 VALUES ($1, $2, $3)
                 ON CONFLICT (user_id)
                 DO UPDATE SET role = EXCLUDED.role`,
                [
                    userId,
                    role,
                    (user.name || user.email || "StreetSpot User").slice(0, 100)
                ]
            );

            if (role === "vendor") {
                await db.query(
                    `INSERT INTO streetspot_vendors
                     (user_id, name, category, lat, lng, is_live, avatar)
                     VALUES ($1, $2, 'Street Food', 11.0168, 76.9558, false, '🛍️')
                     ON CONFLICT (user_id) DO NOTHING`,
                    [userId, (user.name || "My Street Stall").slice(0, 100)]
                );
            }

            await events.publish("streetspot", "changed", {
                action: "role"
            });

            return res.json({ ok: true });
        }

        const own = await db.query(
            "SELECT id FROM streetspot_vendors WHERE user_id = $1",
            [userId]
        );

        if (!own.rows.length) {
            return res.status(400).json({
                error: "Choose Vendor mode first."
            });
        }

        const vendorId = own.rows[0].id;

        // Go live or offline
        if (body.action === "live") {
            const lat = Number(body.lat);
            const lng = Number(body.lng);
            const live = Boolean(body.live);

            if (
                !Number.isFinite(lat) ||
                !Number.isFinite(lng) ||
                Math.abs(lat) > 90 ||
                Math.abs(lng) > 180
            ) {
                return res.status(400).json({
                    error: "Valid location required."
                });
            }

            await db.query(
                `UPDATE streetspot_vendors
                 SET lat = $1,
                     lng = $2,
                     is_live = $3,
                     expires_at = $4
                 WHERE id = $5`,
                [
                    lat,
                    lng,
                    live,
                    live
                        ? new Date(Date.now() + 4 * 60 * 60 * 1000).toISOString()
                        : null,
                    vendorId
                ]
            );
        }

        // Add or update an item
        else if (body.action === "save") {
            const name = String(body.name || "").trim().slice(0, 80);
            const price = Number(body.price);

            if (
                !name ||
                !Number.isFinite(price) ||
                price < 0 ||
                price > 1000000
            ) {
                return res.status(400).json({
                    error: "Enter a valid item name and price."
                });
            }

            if (body.id) {
                await db.query(
                    `UPDATE streetspot_items
                     SET name = $1, price = $2
                     WHERE id = $3 AND vendor_id = $4`,
                    [name, price, body.id, vendorId]
                );
            } else {
                await db.query(
                    `INSERT INTO streetspot_items
                     (vendor_id, name, price)
                     VALUES ($1, $2, $3)`,
                    [vendorId, name, price]
                );
            }
        }

        // Delete an item
        else if (body.action === "delete") {
            await db.query(
                `DELETE FROM streetspot_items
                 WHERE id = $1 AND vendor_id = $2`,
                [body.id, vendorId]
            );
        }

        // Update vendor profile
        else if (body.action === "profile") {
            const name = String(
                body.name || "My Street Stall"
            ).trim().slice(0, 100);

            const allowedCategories = [
                "Street Food",
                "Accessories",
                "Seasonal"
            ];

            const category = allowedCategories.includes(body.category)
                ? body.category
                : "Street Food";

            await db.query(
                `UPDATE streetspot_vendors
                 SET name = $1, category = $2
                 WHERE id = $3`,
                [name, category, vendorId]
            );
        }

        else {
            return res.status(400).json({
                error: "Unknown action."
            });
        }

        await events.publish("streetspot", "changed", {
            action: body.action
        });

        return res.json({ ok: true });

    } catch (error) {
        console.error("StreetSpot API error:", error);

        return res.status(500).json({
            error: "Something went wrong. Please try again."
        });
    }
}
